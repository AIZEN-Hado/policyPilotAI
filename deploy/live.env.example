# FUTURE enterprise infrastructure contract. Names only; no credentials in source.
# For the implemented single-workspace Hostinger pilot, use configure.py instead.
# It generates deploy/.env for compose.yaml. Do not use this file with that compose stack.

# Public HTTPS host pointed at the chosen server.
APP_DOMAIN=
# Only needed if the UI is hosted separately from the API.
FRONTEND_ORIGIN=

# Private database: generated on the server for bundled PostgreSQL,
# or supplied through the provider's secret store for managed PostgreSQL.
DATABASE_URL=

# Runtime identity configuration, resolved with the chosen hosting approach.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET=

# Private model service. Do not expose port 11434 publicly.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_NO_CLOUD=1
OLLAMA_MODEL=
EMBEDDING_MODEL=

# Private file storage; required only if using S3-compatible storage.
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Prefer workload identity instead of static credentials where supported.
