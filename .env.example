# ─────────────────────────────────────────────────────────────────────────────
# PolicyPilotAI — Ollama Edition  |  .env.example
# Copy to .env and adjust as needed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ollama LLM ────────────────────────────────────────────────────────────────
# Ollama server URL (default: local machine)
OLLAMA_BASE_URL=http://localhost:11434

# ┌─────────────────────────────────────────────────────────────────────────┐
# │  GTX 1650 — 4 GB VRAM  →  Use SMALL quantised models only             │
# │                                                                         │
# │  RECOMMENDED (all fit in 4 GB at Q4):                                  │
# │    phi3:mini        ~2.5 GB  ← DEFAULT, best quality for the size      │
# │    llama3.2:3b      ~2.3 GB  ← great alternative                       │
# │    tinyllama        ~0.8 GB  ← fastest, use if phi3 feels slow         │
# │    gemma:2b         ~1.5 GB  ← another solid choice                    │
# │                                                                         │
# │  DO NOT USE on 4 GB VRAM:                                              │
# │    mistral:7b       ~5-6 GB  → CUDA out-of-memory                      │
# │    llama3:8b        ~6 GB    → CUDA out-of-memory                      │
# └─────────────────────────────────────────────────────────────────────────┘
OLLAMA_MODEL=phi3:mini

# Generation settings
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=4096       # reduce to 2048 if you still get OOM errors
LLM_NUM_GPU=99         # offload ALL layers to GPU (Ollama handles the math)
LLM_NUM_THREAD=6       # CPU threads for tokeniser / non-GPU work

# ── Embeddings (CPU only — uses ZERO VRAM) ────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector Store ──────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=data/vectors/faiss_index
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RESULTS=5

# ── Database (zero-config SQLite, created automatically on startup) ───────────
DATABASE_URL=sqlite+aiosqlite:///data/policypilot.db

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ── File Paths ────────────────────────────────────────────────────────────────
POLICY_PDF_DIR=data/policies
OUTPUT_DIR=data/outputs
